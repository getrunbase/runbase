{
  "format": "runbase-template",
  "version": 1,
  "name": "Employee Onboarding Checklist",
  "description": "Employee onboarding automation: each new hire gets a Gmail welcome, first-week Google Calendar invites, a Drive welcome doc, a checklist and a Slack intro.",
  "databases": [{ "slug": "people-ops", "name": "People ops" }],
  "objects": [
    {
      "slug": "employees",
      "name": "Employees",
      "icon": "user-plus",
      "database": "people-ops",
      "fields": [
        { "key": "name", "label": "Name", "type": "text", "title": true },
        { "key": "personal_email", "label": "Personal email", "type": "email", "unique": true },
        { "key": "work_email", "label": "Work email", "type": "email" },
        { "key": "role", "label": "Role", "type": "text" },
        { "key": "team", "label": "Team", "type": "select", "options": ["engineering", "sales", "marketing", "operations", "customer-success", "finance"] },
        { "key": "manager_name", "label": "Manager", "type": "text" },
        { "key": "manager_email", "label": "Manager email", "type": "email" },
        { "key": "buddy_name", "label": "Onboarding buddy", "type": "text" },
        { "key": "start_date", "label": "Start date", "type": "date" },
        { "key": "review_date", "label": "First-week review date", "type": "date" },
        { "key": "time_zone", "label": "Time zone", "type": "text", "default": "Europe/Paris" },
        { "key": "location", "label": "Location", "type": "select", "options": ["office", "remote", "hybrid"] },
        { "key": "status", "label": "Onboarding status", "type": "select", "options": ["pre-boarding", "onboarding", "completed"] },
        { "key": "welcome_doc_id", "label": "Welcome doc ID", "type": "text" },
        { "key": "fun_fact", "label": "Fun fact for the intro", "type": "text" }
      ]
    },
    {
      "slug": "onboarding_tasks",
      "name": "Onboarding tasks",
      "icon": "list-checks",
      "database": "people-ops",
      "fields": [
        { "key": "title", "label": "Task", "type": "text", "title": true },
        { "key": "employee", "label": "Employee", "type": "ref", "object": "employees" },
        { "key": "owner", "label": "Owner", "type": "select", "options": ["people-ops", "it", "manager", "new-hire"] },
        { "key": "due_date", "label": "Due date", "type": "date" },
        { "key": "status", "label": "Status", "type": "select", "options": ["todo", "done"] }
      ]
    }
  ],
  "views": [
    {
      "object": "employees",
      "name": "Starting soon",
      "filter": { "field": "status", "op": "eq", "value": "pre-boarding" },
      "sort": [{ "field": "start_date", "dir": "asc" }],
      "columns": ["name", "role", "team", "manager_name", "start_date", "location"]
    },
    {
      "object": "employees",
      "name": "Currently onboarding",
      "filter": { "field": "status", "op": "eq", "value": "onboarding" },
      "sort": [{ "field": "start_date", "dir": "desc" }]
    },
    {
      "object": "onboarding_tasks",
      "name": "Open tasks",
      "filter": { "field": "status", "op": "eq", "value": "todo" },
      "sort": [{ "field": "due_date", "dir": "asc" }],
      "columns": ["title", "employee", "owner", "due_date"]
    },
    {
      "object": "onboarding_tasks",
      "name": "IT setup",
      "filter": { "field": "owner", "op": "eq", "value": "it" },
      "sort": [{ "field": "due_date", "dir": "asc" }]
    }
  ],
  "workflows": [
    {
      "key": "onboard-new-hire",
      "name": "Onboard a new hire",
      "definition": {
        "trigger": {
          "type": "trigger.record_created",
          "object": "$object:employees"
        },
        "steps": [
          {
            "id": "welcome",
            "type": "node.gmail.send",
            "input": {
              "to": "{{record.personal_email}}",
              "cc": "{{record.manager_email}}",
              "replyTo": "{{record.manager_email}}",
              "subject": "Welcome to the team, {{record.name}}",
              "text": "Hi {{record.name}},\n\nWe are glad you are joining us as {{record.role}} on {{record.start_date}}.\n\nYour manager is {{record.manager_name}} and your onboarding buddy is {{record.buddy_name}}. Your work account is {{record.work_email}}: calendar invites for your first week will arrive there.\n\nOn day one we start at 9:30 with a welcome session. Your manager will share a welcome doc with everything you need for your first week.\n\nIf you have any question before you start, reply to this email.\n\nSee you soon"
            }
          },
          {
            "id": "day_one",
            "type": "node.google_calendar.create_event",
            "input": {
              "calendarId": "primary",
              "summary": "Welcome session: {{record.name}}",
              "description": "First-day welcome for {{record.name}} ({{record.role}}): accounts, tools tour, team lunch.",
              "start": "{{record.start_date}}T09:30:00",
              "end": "{{record.start_date}}T11:00:00",
              "timeZone": "{{record.time_zone}}",
              "attendees": ["{{record.work_email}}", "{{record.manager_email}}"],
              "addMeet": true,
              "sendUpdates": "all"
            }
          },
          {
            "id": "one_on_one",
            "type": "node.google_calendar.create_event",
            "input": {
              "calendarId": "primary",
              "summary": "1:1 {{record.manager_name}} / {{record.name}}",
              "description": "First 1:1: goals for the first 30 days, how the team works, questions.",
              "start": "{{record.start_date}}T14:00:00",
              "end": "{{record.start_date}}T14:45:00",
              "timeZone": "{{record.time_zone}}",
              "attendees": ["{{record.work_email}}", "{{record.manager_email}}"],
              "addMeet": true,
              "sendUpdates": "all"
            }
          },
          {
            "id": "week_review",
            "type": "node.google_calendar.create_event",
            "input": {
              "calendarId": "primary",
              "summary": "First-week review: {{record.name}}",
              "description": "What went well, what is missing, next steps for the first month.",
              "start": "{{record.review_date}}T16:00:00",
              "end": "{{record.review_date}}T16:30:00",
              "timeZone": "{{record.time_zone}}",
              "attendees": ["{{record.work_email}}", "{{record.manager_email}}"],
              "addMeet": true,
              "sendUpdates": "all"
            }
          },
          {
            "id": "welcome_doc",
            "type": "node.google_drive.upload_file",
            "input": {
              "name": "Welcome - {{record.name}}.md",
              "mimeType": "text/markdown",
              "content": "# Welcome, {{record.name}}\n\nRole: {{record.role}}\nTeam: {{record.team}}\nManager: {{record.manager_name}} ({{record.manager_email}})\nBuddy: {{record.buddy_name}}\nStart date: {{record.start_date}}\n\n## Your first week\n\n- Day 1, 9:30: welcome session, accounts and tools tour\n- Day 1, 14:00: first 1:1 with {{record.manager_name}}\n- {{record.review_date}}, 16:00: first-week review\n\n## Before day one\n\n- Sign your contract and send your bank details\n- Read the team handbook\n\n## Useful links\n\n- Team handbook: add your link\n- Org chart: add your link"
            }
          },
          {
            "id": "save",
            "type": "record.update",
            "input": {
              "recordId": "{{record.id}}",
              "data": {
                "status": "pre-boarding",
                "welcome_doc_id": "{{steps.welcome_doc.output.id}}"
              }
            }
          },
          {
            "id": "task_it",
            "type": "record.create",
            "input": {
              "object": "$object:onboarding_tasks",
              "data": { "title": "Create accounts and ship laptop for {{record.name}}", "employee": "{{record.id}}", "owner": "it", "due_date": "{{record.start_date}}", "status": "todo" }
            }
          },
          {
            "id": "task_paperwork",
            "type": "record.create",
            "input": {
              "object": "$object:onboarding_tasks",
              "data": { "title": "Collect signed contract and payroll details from {{record.name}}", "employee": "{{record.id}}", "owner": "people-ops", "due_date": "{{record.start_date}}", "status": "todo" }
            }
          },
          {
            "id": "task_plan",
            "type": "record.create",
            "input": {
              "object": "$object:onboarding_tasks",
              "data": { "title": "Share 30-day plan with {{record.name}}", "employee": "{{record.id}}", "owner": "manager", "due_date": "{{record.review_date}}", "status": "todo" }
            }
          },
          {
            "id": "intro",
            "type": "node.slack.send",
            "input": {
              "webhookUrl": "{{secret.SLACK_WEBHOOK_URL}}",
              "text": "Please welcome {{record.name}}, who joins as {{record.role}} on the {{record.team}} team on {{record.start_date}}. Manager: {{record.manager_name}}, buddy: {{record.buddy_name}}. Fun fact: {{record.fun_fact}}"
            }
          }
        ]
      }
    }
  ],
  "secrets": ["SLACK_WEBHOOK_URL"],
  "records": [
    { "key": "e1", "object": "employees", "data": { "name": "Jordan Lee", "personal_email": "jordan.lee@mail.example", "work_email": "jordan@yourcompany.example", "role": "Account Executive", "team": "sales", "manager_name": "Sam Rivera", "manager_email": "sam@yourcompany.example", "buddy_name": "Lea Martin", "start_date": "2026-12-07", "review_date": "2026-12-11", "time_zone": "Europe/Paris", "location": "hybrid", "status": "pre-boarding", "fun_fact": "Ran the Paris marathon twice" } },
    { "key": "e2", "object": "employees", "data": { "name": "Aisha Bello", "personal_email": "aisha.bello@mail.example", "work_email": "aisha@yourcompany.example", "role": "Growth Marketer", "team": "marketing", "manager_name": "Nora Klein", "manager_email": "nora@yourcompany.example", "buddy_name": "Tom Becker", "start_date": "2026-11-23", "review_date": "2026-11-27", "time_zone": "Europe/London", "location": "remote", "status": "onboarding", "fun_fact": "Bakes sourdough every weekend" } },
    { "key": "e3", "object": "employees", "data": { "name": "Marco Rossi", "personal_email": "marco.rossi@mail.example", "work_email": "marco@yourcompany.example", "role": "Ops Analyst", "team": "operations", "manager_name": "Sam Rivera", "manager_email": "sam@yourcompany.example", "buddy_name": "Aisha Bello", "start_date": "2026-11-02", "review_date": "2026-11-06", "time_zone": "Europe/Rome", "location": "office", "status": "completed", "fun_fact": "Speaks four languages" } },
    { "key": "t1", "object": "onboarding_tasks", "data": { "title": "Create accounts and ship laptop for Jordan Lee", "employee": "$record:e1", "owner": "it", "due_date": "2026-12-07", "status": "todo" } },
    { "key": "t2", "object": "onboarding_tasks", "data": { "title": "Collect signed contract and payroll details from Jordan Lee", "employee": "$record:e1", "owner": "people-ops", "due_date": "2026-12-07", "status": "done" } },
    { "key": "t3", "object": "onboarding_tasks", "data": { "title": "Share 30-day plan with Aisha Bello", "employee": "$record:e2", "owner": "manager", "due_date": "2026-11-27", "status": "todo" } }
  ]
}
