        "client": "$record:cl-globex",
        "amount": 1500,
        "issue_date": "2026-11-20",
        "due_date": "2026-12-20",
        "status": "sent",
        "drive_link": "https://drive.google.com/"
      }
    },
    {
      "key": "inv-3",
      "object": "invoices",
      "data": {
        "description": "Analytics setup workshop",
