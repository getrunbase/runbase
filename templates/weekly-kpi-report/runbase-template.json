    {
      "key": "snapshot-nov-16",
      "object": "kpi_snapshots",
      "data": {
        "week": "2026-11-16",
        "new_deals": 3,
        "new_pipeline": 21500,
        "open_deals": 7,
        "open_pipeline": 64300,
        "won_deals": 1,
