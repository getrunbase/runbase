        "next_steps": "Sofia sends terms to legal. We hold the current price until December 15.",
        "status": "sent",
        "sent_at": "2026-11-25T11:10:00Z",
        "thread_id": "sample-thread-103"
      }
    },
    {
      "key": "f4",
      "object": "follow-ups",
      "data": {
        "event_id": "sample-evt-104",
        "meeting": "Quick sync: Acme",
        "attendees": "li@acme.example",
        "start": "2026-11-24T08:00:00Z",
        "ended_at": "2026-11-24T08:15:00Z",
        "notes": "",
        "subject": "Thanks for the quick sync",
        "draft": "Hi Li,\n\nThanks for the quick sync this morning...",
        "next_steps": "Li confirms the next step.",
        "status": "skipped"
      }
    }
  ]
}
