        "status": "pending"
      }
    },
    {
      "key": "l2",
      "object": "leave_requests",
      "data": {
        "employee": "Daniel Ortiz",
        "email": "daniel@yourcompany.example",
        "team": "RevOps",
        "manager_email": "lea@yourcompany.example",
        "leave_type": "vacation",
        "first_day": "2026-12-08",
        "back_on": "2026-12-11",
        "working_days": 3,
        "note": "",
