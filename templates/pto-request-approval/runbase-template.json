      }
    },
    {
      "key": "l3",
      "object": "leave_requests",
      "data": {
        "employee": "Priya Nair",
        "email": "priya@yourcompany.example",
        "team": "Marketing",
        "manager_email": "sam@yourcompany.example",
        "leave_type": "parental",
        "first_day": "2027-02-01",
        "back_on": "2027-05-03",
        "working_days": 64,
        "note": "Handover plan shared with the team",
        "status": "approved"
      }
    },
    {
      "key": "l4",
      "object": "leave_requests",
      "data": {
        "employee": "Tom Becker",
        "email": "tom@yourcompany.example",
        "team": "Operations",
        "manager_email": "lea@yourcompany.example",
        "leave_type": "unpaid",
        "first_day": "2026-12-28",
        "back_on": "2027-01-02",
