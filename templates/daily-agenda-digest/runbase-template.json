    {
      "key": "c3",
      "object": "contacts",
      "data": {
        "name": "Li Wei",
        "email": "li@acme.example",
        "company": "Acme",
        "role": "Founder",
        "relationship": "partner",
        "notes": "Co-marketing webinar planned for Q1. Prefers short agendas.",
        "last_met": "2026-10-30"
      }
    },
    {
      "key": "c4",
      "object": "contacts",
      "data": {
        "name": "Sofia Rossi",
        "email": "sofia@greenleaf.example",
        "company": "Greenleaf Capital",
        "role": "Partner",
        "relationship": "investor",
        "notes": "Monthly update call. Interested in churn and net revenue retention.",
        "last_met": "2026-10-28"
      }
    },
    {
      "key": "d1",
      "object": "agenda_digests",
      "data": {
        "day": "2026-11-27",
        "meetings": 4,
        "known_attendees": 3,
        "unknown_attendees": 1,
        "brief": "9:30 Northwind QBR with Maria Lopez (Head of Operations, customer): renewal in January, bring the seat count review.\n14:00 Bright Labs pricing call with James Carter (VP Sales, prospect): he needs a proposal before Christmas.\nMost preparation: Bright Labs.",
        "sent_at": "2026-11-27T07:30:00+01:00"
      }
    }
  ]
}
