# Runbase configuration.
#
# Self-hosting: run ./setup.sh. It copies this file to .env and replaces every
# secret below with a strong random value (never keep the change-me values).
# Local development: cp .env.example .env (the defaults match docker-compose.yml).

# =============================================================================
# REQUIRED
# =============================================================================

# Public URL of the app (used for sign-in links and OAuth). Behind a reverse
# proxy, set the https URL users type in their browser.
BETTER_AUTH_URL=http://localhost:7100

# Session signing secret, at least 32 characters (openssl rand -base64 32).
BETTER_AUTH_SECRET=

# Secrets vault master key: 32 bytes, base64 (openssl rand -base64 32).
# Only lives in the environment, never in the database. Losing it makes stored
# secrets unreadable: back it up with your database backups.
SECRETS_MASTER_KEY=

# Postgres (service `postgres`).
POSTGRES_USER=runbase
POSTGRES_PASSWORD=change-me
POSTGRES_DB=runbase

# Password of the read-only `runbase_query` role used by the SQL console.
# `pnpm db:migrate` (the `migrate` service) applies it to the role.
QUERY_DB_PASSWORD=change-me-query

# Redis password (requirepass): Redis never accepts a client without it, in
# both compose files. Keep REDIS_URL below in sync (redis://:<password>@host:port).
REDIS_PASSWORD=change-me-redis

# Shared token between web/worker and the `sandbox` service that runs function
# code, at least 16 characters (openssl rand -hex 24).
SANDBOX_TOKEN=change-me-sandbox-token

# Outside containers (pnpm test, pnpm db:migrate), the apps read these URLs.
# Inside containers, the compose files build them from the values above.
# Keep the ports aligned with POSTGRES_PORT and REDIS_PORT.
DATABASE_URL=postgres://runbase:change-me@localhost:5432/runbase
QUERY_DATABASE_URL=postgres://runbase_query:change-me-query@localhost:5432/runbase
REDIS_URL=redis://:change-me-redis@localhost:6380

# =============================================================================
# OPTIONAL
# =============================================================================

# --- Sign-in method -----------------------------------------------------------
# Read at runtime (no rebuild needed). magic-link (default): passwordless link
# sent by email. password: email + password (8 characters min); password reset
# by email only when Resend or SMTP is configured below.
AUTH_METHOD=magic-link

# --- Email (sign-in links, invitations, email block) -------------------------
# Provider order: Resend if RESEND_API_KEY is set, else SMTP if SMTP_HOST is
# set, else console mode: nothing is sent, emails are printed in the web logs
# (sign-in links included). EMAIL_FROM is required with a provider (verified
# sender); console mode defaults to noreply@localhost.
EMAIL_FROM=
RESEND_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# true = TLS from the start (default for port 465), false = STARTTLS if offered.
# SMTP_SECURE=

# --- Accounts ----------------------------------------------------------------
# Public sign-ups are closed unless "true". First owner:
#   docker compose -f docker-compose.selfhost.yml exec worker pnpm admin:create you@example.com
SIGNUPS_ENABLED=false
# Platform admins allowed on Bull Board (jobs of every tenant), comma-separated.
# Empty = nobody.
PLATFORM_ADMIN_EMAILS=

# --- Ports -------------------------------------------------------------------
# Host port of the web app (Next.js listens on 3000 in the container).
WEB_PORT=7100
# Self-host only: host interface the web port binds to. 127.0.0.1 = reachable
# only through a reverse proxy on the same machine; 0.0.0.0 = every interface.
# WEB_BIND=127.0.0.1
# Bull Board (worker): http://localhost:7101/admin/queues (development only).
BOARD_PORT=7101
# Development only: Postgres and Redis ports published on 127.0.0.1.
POSTGRES_PORT=5432
REDIS_PORT=6380
# Port Next.js listens on inside the process (set by `next start` / the image).
# Also the fallback origin of the renderer (http://127.0.0.1:$PORT).
# PORT=7100
# Port of the function sandbox server (`sandbox` container, apps/worker/src/sandbox.ts).
# SANDBOX_PORT=7200

# --- Self-host images ----------------------------------------------------------
# Images pulled by docker-compose.selfhost.yml: <repo>-web and <repo>-worker.
# RUNBASE_IMAGE_REPO=ghcr.io/getrunbase/runbase
# Pin a release tag for reproducible updates (default: latest).
# RUNBASE_VERSION=latest

# --- Files -------------------------------------------------------------------
# Uploaded files directory (local disk). The self-host stack stores them in the
# `files-data` volume.
# FILES_DIR=/data/files

# --- Functions runtime -------------------------------------------------------
# Deno 2.x binary used by the worker. Unset = `deno` from PATH. The Docker
# images set DENO_BIN=/usr/local/bin/deno.
# DENO_BIN=/path/to/deno
# Functions cannot reach private IPs, loopback, link-local (cloud metadata) or
# CGNAT by default (anti-SSRF), even through DNS. 1 = allowed (local dev,
# self-hosting that calls internal services).
# FUNCTIONS_ALLOW_PRIVATE_NETWORK=1
# HTTP block: maximum response size in bytes (default 10 MB).
# HTTP_BLOCK_MAX_BYTES=10485760
# Outside containers, SANDBOX_URL unset = Deno runs locally with an empty env.
# The compose files set it to http://sandbox:7200.
# SANDBOX_URL=http://localhost:7200
# Deno cache directory forwarded to the function process (the only Deno env
# variable passed through besides PATH and HOME). Unset = Deno default.
# DENO_DIR=/tmp/deno
# Deno registry overrides for npm: and jsr: specifiers. Not needed in
# production: functions cannot import remote modules. The sandbox tests point
# them at a local server to prove no request leaves the sandbox.
# NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
# JSR_URL=https://jsr.io/
# Tests only: name of a built sandbox image; enables the container integration
# tests of packages/core (e.g. SANDBOX_IMAGE=runbase-sandbox).
# SANDBOX_IMAGE=runbase-sandbox

# --- Public routes -----------------------------------------------------------
# Trusted reverse proxies in front of Next.js (Caddy, nginx: 1), the only ones
# allowed to set X-Forwarded-For; max request body (bytes); calls per minute
# and per IP before authentication.
# TRUSTED_PROXY_HOPS=1
# BODY_MAX_BYTES=1048576
# IP_RATE_HOOKS=600
# IP_RATE_INGEST=600
# IP_RATE_AUTH=60
# IP_RATE_MCP=600

# --- Quotas ------------------------------------------------------------------
# Requests per minute per API key on the public REST API (/api/v1).
# API_V1_RATE_LIMIT=600
# Default limits per workspace, capped by the account entitlements.
# QUOTA_RECORDS=100000
# QUOTA_RUNS_PER_MINUTE=120
# QUOTA_API_PER_MINUTE=1200
# Caps without a billing extension: unset = unlimited.
# QUOTA_MAX_RECORDS=
# QUOTA_MAX_RUNS_PER_MINUTE=
# QUOTA_MAX_RUNS_PER_MONTH=
# QUOTA_MAX_STORAGE_BYTES=
# QUOTA_MAX_API_PER_MINUTE=
# QUOTA_MAX_WORKSPACES=
# QUOTA_MAX_PAGES=
# QUOTA_MAX_AI_BUDGET_USD=
# Caps function timeouts and the execution time of a run (ms, waits excluded).
# QUOTA_MAX_RUN_DURATION_MS=
# Shortest interval between two runs of a schedule trigger, in seconds.
# QUOTA_CRON_MIN_INTERVAL_SEC=
# Cache of the limits per workspace (ms).
# QUOTA_LIMITS_TTL_MS=15000

# --- Postgres pools ----------------------------------------------------------
# PG_POOL_MAX: main pool per process; QUERY_PG_POOL_MAX: SQL console pool;
# QUERY_TIMEOUT_MS: max duration of a console query. Behind PgBouncer in
# transaction mode: PG_PREPARE=false.
# PG_POOL_MAX=10
# QUERY_PG_POOL_MAX=5
# QUERY_TIMEOUT_MS=10000
# PG_PREPARE=false

# --- File storage (S3) -------------------------------------------------------
# FILES_DRIVER=local (disk, FILES_DIR) or s3 (S3-compatible: Cloudflare R2,
# MinIO, AWS S3). With s3, web and worker are stateless; downloads and direct
# uploads use presigned URLs (60 s). Switch: pnpm files:migrate (idempotent,
# --dry-run to preview) before and right after FILES_DRIVER=s3.
# R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto.
# Local MinIO (dev/tests only): docker compose --profile files up -d minio
# minio-init, then S3_ENDPOINT=http://localhost:9000, S3_BUCKET=runbase-files,
# credentials minio / minio-secret. The bucket stays private.
# Direct upload from the browser (presigned PUT): the bucket CORS rule must
# allow PUT and the content-type header from BETTER_AUTH_URL.
# FILES_DRIVER=local
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3 driver tests against MinIO (skipped otherwise):
# S3_TEST_ENDPOINT=http://localhost:9000

# --- Renderer ----------------------------------------------------------------
# Headless Chromium outside the web app, behind the `render` queue
# (page.screenshot, components.test { screenshot }, accessibility audits).
# RENDERER_APP_URL: web origin seen by the renderer (default
# http://127.0.0.1:$PORT in dev; http://web:3000 in the compose files).
# RENDERER_APP_URL=
# RENDER_CONCURRENCY=2
# RENDERER_HEALTH_PORT=7102
# Chromium: system binary (Docker image), else Playwright's
# chromium-headless-shell (npx playwright-core install chromium-headless-shell).
# PLAYWRIGHT_CHROMIUM_PATH=
# Chromium OS sandbox (default true). docker-compose.selfhost.yml sets false:
# its hardened container cannot create the sandbox's namespaces.
# CHROMIUM_SANDBOX=true

# --- Code component runtime --------------------------------------------------
# Dedicated origin of the sandboxed iframe runtime (/c/runtime), e.g.
# https://runtime.example.com (same app, second domain). Empty: app origin.
# Baked in at build time (NEXT_PUBLIC_): changing it needs a rebuild of the web
# image (docker build --build-arg NEXT_PUBLIC_RUNTIME_ORIGIN=...).
# Local dev with two origins: app on http://localhost:7100, runtime on
# NEXT_PUBLIC_RUNTIME_ORIGIN=http://127.0.0.1:7100
# NEXT_PUBLIC_RUNTIME_ORIGIN=

# --- Retention, queues -------------------------------------------------------
# Jobs run at the same time per workspace and per queue;
# quotas.set { concurrency } overrides per workspace.
# QUOTA_CONCURRENCY=5
# Retention in days (unset = never purged) and schedule of the purge.
# RETENTION_DAYS=
# RETENTION_CRON=0 3 * * *
# Usage reported to the billing extension (only with RUNBASE_EXTENSIONS).
# USAGE_REPORT_CRON=0 * * * *
# BullMQ key prefix (default bull): a dedicated value isolates a test run on a
# shared Redis.
# QUEUE_PREFIX=bull

# --- Observability -----------------------------------------------------------
# Every variable is validated on start (packages/core/src/env.ts): a missing or
# invalid value stops the app with a clear message. See docs/observability.md.
# LOG_LEVEL=info
# APP_VERSION=
# OpenTelemetry metrics: no export by default (none). otlp: OTLP/HTTP export
# to OTEL_EXPORTER_OTLP_ENDPOINT; console: printed in the logs.
# OTEL_METRICS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_METRIC_EXPORT_INTERVAL=60000
# OTEL_SERVICE_NAME=runbase-web

# --- Anonymous telemetry -----------------------------------------------------
# One daily ping from the worker (random instance id, version, OS/arch,
# bucketed counts; no personal data). Fields: docs/self-hosting.md.
# On by default. RUNBASE_TELEMETRY=0 disables it.
# RUNBASE_TELEMETRY=0
# Other receiver (default: the project's receiver).
# RUNBASE_TELEMETRY_URL=

# Extensions (optional): module (package name or path) loaded at web and
# worker startup to replace the no-op telemetry, billing and managed
# credentials hooks. Unset or not installed = no-op. See docs/extensions.md.
# RUNBASE_EXTENSIONS=

# In production (NODE_ENV=production) the web app and worker refuse to start
# while a secret still holds a change-me value. The local docker-compose.yml
# stack sets this to 1; never set it on a real deployment.
# RUNBASE_ALLOW_PLACEHOLDER_SECRETS=0

# --- Catalog and connectors --------------------------------------------------
# Public catalog index (JSON built by `pnpm catalog:validate --out <file>`).
# The Docker image sets it to /app/catalog-index.json. Unset = read the
# repository folders (see CATALOG_ROOT).
# CATALOG_INDEX=/app/catalog-index.json
# Repository root that holds templates/, connectors/ and authors/. Unset = the
# nearest parent folder of the working directory that contains templates/.
# CATALOG_ROOT=/app
# Template submissions open a pull request on this GitHub repository
# (owner/repo). Both variables are required; unset = submissions disabled.
# The token needs contents and pull request write access.
# CATALOG_GITHUB_REPO=owner/repo
# CATALOG_GITHUB_TOKEN=
# GitHub API base URL (GitHub Enterprise) and target branch of submissions.
# CATALOG_GITHUB_API=https://api.github.com
# CATALOG_GITHUB_BASE=main
# Connector root folders, separated by `:`. Unset = the nearest `connectors/`
# and `node_modules/@getrunbase-connectors/` found walking up from the working
# directory.
# RUNBASE_CONNECTORS_DIRS=/app/connectors:/app/node_modules/@getrunbase-connectors

# Google connector (Gmail send, Calendar, Sheets, Drive files): OAuth client,
# type "Web application", redirect URI <BETTER_AUTH_URL>/api/connections/callback.
# Needed by web and worker. Setup and scopes: docs/guides/google.
# Other OAuth connectors: OAUTH_<PROVIDER>_CLIENT_ID / OAUTH_<PROVIDER>_CLIENT_SECRET.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
