{
  "name": "@getrunbase/sdk",
  "version": "0.2.0",
  "description": "React hooks SDK for Runbase code components: live queries, optimistic mutations, keyset pagination.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getrunbase/runbase.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "@types/node": "^22.20.5"
  }
}
