                    "htmlLink": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "meetLink": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "attendees": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "email": {
                            "type": "string"
                          },
                          "responseStatus": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "email",
                          "responseStatus"
