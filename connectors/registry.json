{
  "connectors": [
    {
      "name": "@getrunbase-connectors/gmail",
      "version": "0.1.0",
      "label": "Gmail",
      "description": "Send emails from a Gmail account.",
      "path": "gmail",
      "nodes": [
        {
          "id": "gmail.send",
          "label": "Send an email",
          "description": "Sends an email from the connected Gmail account. Give text, html or both. threadId (and the original Message-ID in inReplyTo) sends it as a reply in that thread.",
          "branches": [
            "ok"
          ],
          "sideEffect": true,
          "auth": {
            "secrets": [],
            "domains": [
              "gmail.googleapis.com"
            ],
            "oauth": {
              "provider": "google",
              "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
              "tokenUrl": "https://oauth2.googleapis.com/token",
              "revokeUrl": "https://oauth2.googleapis.com/revoke",
              "scopes": [
                "openid",
                "email",
                "https://www.googleapis.com/auth/gmail.send"
              ],
              "authorizeParams": {
                "access_type": "offline",
                "prompt": "consent",
                "include_granted_scopes": "true"
              }
            }
          },
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "to": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 3
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 3
                    }
                  }
                ]
              },
              "cc": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 3
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 3
                    }
                  }
                ]
              },
              "bcc": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 3
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 3
                    }
                  }
                ]
              },
              "replyTo": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "html": {
                "type": "string"
              },
              "threadId": {
                "type": "string"
              },
              "inReplyTo": {
                "type": "string"
              },
              "connection": {
                "description": "Name of the google connection to use",
                "type": "string"
              }
            },
            "required": [
              "to",
              "subject"
            ]
          },
          "outputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "threadId": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "threadId"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "name": "@getrunbase-connectors/google-calendar",
      "version": "0.1.0",
      "label": "Google Calendar",
      "description": "List, create, update and delete Google Calendar events.",
      "path": "google-calendar",
      "nodes": [
        {
          "id": "google_calendar.list_events",
          "label": "List events",
          "description": "Lists the events of a calendar between two dates (recurring events expanded), sorted by start. q filters by text.",
          "branches": [
            "ok"
          ],
          "sideEffect": false,
          "auth": {
            "secrets": [],
            "domains": [
              "www.googleapis.com"
            ],
            "oauth": {
              "provider": "google",
              "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
              "tokenUrl": "https://oauth2.googleapis.com/token",
              "revokeUrl": "https://oauth2.googleapis.com/revoke",
              "scopes": [
                "openid",
                "email",
                "https://www.googleapis.com/auth/calendar.events",
                "https://www.googleapis.com/auth/calendar.calendarlist.readonly"
              ],
              "authorizeParams": {
                "access_type": "offline",
                "prompt": "consent",
                "include_granted_scopes": "true"
              }
            }
          },
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "calendarId": {
                "default": "primary",
                "description": "Calendar id; primary = the account's main calendar",
                "type": "string"
              },
              "timeMin": {
                "description": "ISO date-time, default now",
                "type": "string"
              },
              "timeMax": {
                "description": "ISO date-time",
                "type": "string"
              },
              "q": {
                "type": "string"
              },
              "maxResults": {
                "default": 50,
                "type": "integer",
                "minimum": 1,
                "maximum": 250
              },
              "connection": {
                "description": "Name of the google connection to use",
                "type": "string"
              }
            }
          },
          "outputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "events": {
                "type": "array",
