    {
      "name": "@getrunbase-connectors/google-drive",
      "version": "0.1.0",
      "label": "Google Drive",
      "description": "Create files in Google Drive.",
      "path": "google-drive",
      "nodes": [
        {
          "id": "google_drive.upload_file",
          "label": "Create a file",
          "description": "Creates a file in Google Drive from text (or base64 content). Runbase only sees the files it created.",
          "branches": [
            "ok"
          ],
          "sideEffect": true,
          "auth": {
            "secrets": [],
            "domains": [
              "www.googleapis.com"
            ],
            "oauth": {
              "provider": "google",
              "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
              "tokenUrl": "https://oauth2.googleapis.com/token",
              "revokeUrl": "https://oauth2.googleapis.com/revoke",
              "scopes": [
                "openid",
                "email",
                "https://www.googleapis.com/auth/drive.file"
              ],
              "authorizeParams": {
                "access_type": "offline",
                "prompt": "consent",
                "include_granted_scopes": "true"
              }
            }
          },
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              },
              "encoding": {
                "default": "text",
                "type": "string",
                "enum": [
                  "text",
                  "base64"
                ]
              },
              "mimeType": {
                "default": "text/plain",
                "type": "string"
              },
              "folderId": {
                "type": "string"
              },
              "connection": {
                "description": "Name of the google connection to use",
                "type": "string"
              }
            },
            "required": [
              "name",
              "content"
            ]
          },
          "outputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "webViewLink": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "webViewLink"
            ],
            "additionalProperties": false
          }
        }
      ]
