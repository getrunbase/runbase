    {
      "name": "@getrunbase-connectors/google-sheets",
      "version": "0.1.0",
      "label": "Google Sheets",
      "description": "Read rows, add rows and update cells in Google Sheets.",
      "path": "google-sheets",
      "nodes": [
        {
          "id": "google_sheets.read_rows",
          "label": "Read rows",
          "description": "Reads a range (e.g. Sheet1, or Sheet1!A1:D100). headers=true: the first row gives the keys of each row object.",
          "branches": [
            "ok"
          ],
          "sideEffect": false,
          "auth": {
            "secrets": [],
            "domains": [
              "sheets.googleapis.com"
            ],
            "oauth": {
              "provider": "google",
              "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
              "tokenUrl": "https://oauth2.googleapis.com/token",
              "revokeUrl": "https://oauth2.googleapis.com/revoke",
              "scopes": [
                "openid",
                "email",
                "https://www.googleapis.com/auth/spreadsheets",
                "https://www.googleapis.com/auth/drive.file"
              ],
              "authorizeParams": {
                "access_type": "offline",
                "prompt": "consent",
                "include_granted_scopes": "true"
              }
            }
          },
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "spreadsheetId": {
                "type": "string",
                "minLength": 1,
                "description": "Id in the sheet URL: docs.google.com/spreadsheets/d/<id>/edit"
              },
              "range": {
                "type": "string",
                "minLength": 1
              },
              "headers": {
                "default": true,
                "type": "boolean"
              },
              "connection": {
                "description": "Name of the google connection to use",
                "type": "string"
              }
            },
            "required": [
              "spreadsheetId",
              "range"
            ]
          },
          "outputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "rows": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  ]
                }
              }
            },
            "required": [
              "rows"
            ],
            "additionalProperties": false
          },
          "options": [
            "spreadsheetId",
            "range"
          ]
        },
        {
          "id": "google_sheets.append_rows",
          "label": "Add rows",
          "description": "Adds rows after the last row of a tab. Rows as objects are matched to the header row (first row) by column name; rows as arrays are written as is.",
          "branches": [
            "ok"
          ],
          "sideEffect": true,
          "auth": {
            "secrets": [],
            "domains": [
              "sheets.googleapis.com"
            ],
            "oauth": {
              "provider": "google",
              "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
              "tokenUrl": "https://oauth2.googleapis.com/token",
              "revokeUrl": "https://oauth2.googleapis.com/revoke",
              "scopes": [
                "openid",
                "email",
                "https://www.googleapis.com/auth/spreadsheets",
                "https://www.googleapis.com/auth/drive.file"
              ],
              "authorizeParams": {
                "access_type": "offline",
                "prompt": "consent",
                "include_granted_scopes": "true"
              }
            }
