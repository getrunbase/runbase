{
  "connectors": [
    {
      "name": "@getrunbase-connectors/slack",
      "version": "0.1.0",
      "label": "Slack",
      "description": "Send messages to a Slack channel through an Incoming Webhook.",
      "path": "slack",
      "nodes": [
        {
          "id": "slack.send",
          "label": "Send a Slack message",
          "description": "Sends a message to the Slack channel of an Incoming Webhook. The webhook URL can be typed or picked from the workspace secrets.",
          "branches": [
            "ok"
          ],
          "sideEffect": true,
          "auth": {
            "secrets": [],
            "domains": [
              "hooks.slack.com"
            ]
          },
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "webhookUrl": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "webhookUrl",
              "text"
            ]
          },
          "outputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "status": {
                "type": "number"
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          }
        }
      ]
    }
  ]
}
